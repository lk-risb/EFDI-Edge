# EFDI-Edge — compose environment.
# Copy to .env and populate by hand. first-boot.sh reads this file; it no
# longer writes it (same convention as the parent EFDI repo).
# .env is NOT committed (secrets + per-deployment values).

# Where this pod keeps state (certs, rocksdb, logs, PID files).
# Defaults to compose/state/ inside the repo (gitignored) if left unset —
# override here only if you want it somewhere else, e.g. a dedicated data disk.
#POD_STATE_DIR=/var/lib/efdi-edge

# This edge router's own namespace prefix for the key-exprs it publishes
# under. Certs for this namespace come from scripts/pki/enroll-router.sh.
PARTNER_NAMESPACE=example-edge

# Deployment topic prefix. May contain one or more path segments.
NAMESPACE_PREFIX=EFDI

# Runtime data publish prefix, separate from federation/topology naming.
# Leave blank for the slot-root contract (<PARTNER_NAMESPACE>/**); normally
# match NAMESPACE_PREFIX.
DATA_NAMESPACE_PREFIX=EFDI

# The parent zenoh-gateway endpoint this router dials out to. This is what
# actually joins the edge box to the fabric — never point a router at its
# own listen endpoint.
ZENOH_FABRIC_ENDPOINT=

# Optional explicit Zenoh mesh links. Use a JSON array for redundant parent
# uplinks and/or same-level links. These are direct sessions only; NetBird
# reachability does not cause automatic Zenoh connections.
# ZENOH_FABRIC_ENDPOINTS='["tls/zenoh-gateway.example.internal:7447"]'

# Stable id for this router — audit/metric label and the name it shows up
# under in the fabric inspector (panoscope).
POD_ID=efdi-edge

# Endpoint the local control plane connects to (the local router). MUST be
# the router's MESH IP, not loopback, once NetBird is up — network_mode:host
# makes a loopback endpoint conflict with the TLS listener on :7447.
# first-boot.sh resolves the mesh IP via `netbird status`; falls back to
# loopback if NetBird isn't connected yet.
ZENOH_LOCAL_ENDPOINT=tcp/127.0.0.1:7448
ZENOH_LISTEN_PORT=7447
ZENOH_LOCAL_TCP_PORT=7448

# Logging.
ZENOH_LOG=info

# NetBird mesh (optional) — set only if this router should join a NetBird
# network on first-boot. Leave unset if NetBird is already connected.
#NETBIRD_SETUP_KEY=

# ── Local control agent (admin-control) ─────────────────────────────────────
# This is what the central zenoh-gateway/SCOUT WebUI actually talks to —
# there is no local WebUI on this box. It exposes start/stop/restart,
# .env edits, and log tailing over HTTP, gated by EFDI_CONTROL_TOKEN. Bind it
# to the NetBird mesh IP (not 0.0.0.0) so it's reachable from the gateway but
# not the open network.
EFDI_CONTROL_BIND=127.0.0.1
EFDI_CONTROL_PORT=18896
EFDI_CONTROL_URL=http://127.0.0.1:18896
# Generate an explicit token: openssl rand -hex 32
# If left empty, this falls back to a hash of ZENOH_ADMIN_SECRET_KEY below —
# set at least one of the two.
EFDI_CONTROL_TOKEN=<generate-a-random-token>
EFDI_SHELL_CONTROL_HOST=127.0.0.1
EFDI_SHELL_CONTROL_PORT=18897
# Signs/derives the control token above if EFDI_CONTROL_TOKEN is left unset.
# Generate with: openssl rand -hex 32
ZENOH_ADMIN_SECRET_KEY=

# Name of this router's zenoh-router container — the one admin-control
# restarts and health-checks. Only override if more than one router runs on
# a single Docker host.
#ZENOH_ROUTER_CONTAINER=efdi-edge-zenoh-router

# ── Remote config push (federation) — the actual "gateway controls this
# ── box" mechanism ───────────────────────────────────────────────────────
# Set these so this router accepts signed config pushes + restart commands
# from the central zenoh-gateway/SCOUT instance. Leave all unset to reject
# every push (the safe default until enrollment is complete).
# Host path to the trusted parent's public transport certificate.
#ZENOH_ADMIN_TRUSTED_PARENT_HOST_CERT_PATH=/runtime/efdi-pki/trusted-parent-cert.pem
# Expected Subject CN on that cert — sanity-checked alongside the signature.
#ZENOH_ADMIN_TRUSTED_PARENT_CN=
# Explicit parent topology namespace. Managed enrollment writes this in
# automatically; set it only when migrating an existing bundle.
#EFDI_PARENT_NAMESPACE=
# Non-CA ECDSA policy signer the parent uses to sign delegation, topology,
# status, and management-command pushes. Verifying key only — this router
# cannot issue certificates with it.
#EFDI_POLICY_SIGNER_CERT_PATH=/runtime/efdi-pki/policy-signer-cert.pem
#EFDI_POLICY_SIGNER_KEY_PATH=/runtime/efdi-pki/policy-signer-key.pem
# Stable identity trust domain shared by every managed router.
#EFDI_TRUST_DOMAIN=efdi.global

# ── Certificate renewal (cert-renewer) ──────────────────────────────────────
# Point this router's short-lived leaf-cert renewal at the parent's step-ca.
# Initialize enrollment with scripts/pki/enroll-router.sh; the launcher then
# starts the PID-managed renewer automatically once these are set.
#EFDI_STEP_CA_URL=https://zenoh-gateway.example:9000
#EFDI_STEP_RENEW_ROOT_PATH=/runtime/efdi-certs/efdi/efdi-ca-root.pem
#EFDI_STEP_RENEW_CERT_PATH=/runtime/efdi-certs/efdi/child-cert.pem
#EFDI_STEP_RENEW_KEY_PATH=/runtime/efdi-certs/efdi/child-key.pem
#EFDI_STEP_RENEW_RUNTIME_CERT_PATH=/runtime/efdi-state/zenoh/tls/pod-cert.pem
#EFDI_STEP_RENEW_CHECK_SECONDS=900
#EFDI_STEP_RENEW_BEFORE_SECONDS=28800

# Only set these if THIS router runs its own local step-ca (Compose profile
# managed-ca) rather than enrolling as a child of a central one — unusual
# for an edge box, but supported. Initialize with scripts/pki/init-step-ca.sh.
#EFDI_STEP_CA_PORT=9000
#EFDI_STEP_CA_STATE_PATH=/runtime/efdi-state/pki/step-ca
#EFDI_ROUTER_CA_CERT_PATH=/runtime/efdi-pki/router-ca-cert.pem
#EFDI_ROUTER_CA_KEY_PATH=/runtime/efdi-pki/router-ca-key.pem
#EFDI_ROUTER_CA_CHAIN_PATH=/runtime/efdi-pki/router-ca-chain.pem
